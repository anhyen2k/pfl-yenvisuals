rules_version = '2';
// Firebase Storage cho Yen Photo.
// - Khach xem duoc anh portfolio (public read).
// - Chi admin (Google anhyenk26@gmail.com) moi duoc upload / xoa anh.
// Deploy rieng file nay len Firebase (khong tu len theo code web):
//   firebase deploy --only storage
// hoac trong Firebase Console > Storage > Rules: dan noi dung file nay vao roi Publish.
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() { return request.auth != null; }
    function isAdmin() {
      return isSignedIn() && request.auth.token.email.lower() == "anhyenk26@gmail.com";
    }
    match /portfolio_photos/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
    // (v6) Anh proofing theo don: public read, CHI ADMIN write (<=8MB, image).
    match /proofing/{leadId}/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
    // (v7.6) File test chan doan (Dashboard > Cai dat > Kiem tra ket noi
    // Cloud): chi admin ghi/xoa, khong ai doc — file test duoc xoa ngay
    // sau khi up xong. Khong co rule nay thi test Storage bao loi quyen.
    match /diagnostics/{fileName} {
      allow read, write: if isAdmin();
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
