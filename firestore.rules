rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        ('email' in request.auth.token && request.auth.token.email.lower() == "anhyenk26@gmail.com") ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidBookingLead(data) {
      return data.keys().hasAll(['clientName', 'email', 'phone', 'packageType', 'preferredDate'])
        && data.clientName is string && data.clientName.size() >= 2 && data.clientName.size() <= 200
        && data.email is string && data.email.size() >= 5 && data.email.size() <= 200
        && data.phone is string && data.phone.size() >= 8 && data.phone.size() <= 30
        && data.packageType is string && data.packageType.size() <= 64
        && data.preferredDate is string && data.preferredDate.size() <= 30
        && (!('location' in data) || (data.location is string && data.location.size() <= 200))
        && (!('groupSize' in data) || (data.groupSize is string && data.groupSize.size() <= 100))
        && (!('message' in data) || (data.message is string && data.message.size() <= 2000))
        && (!('status' in data) || (data.status in ['new', 'consulting', 'deposited', 'completed', 'cancelled']))
        && (!('estimatedPrice' in data) || data.estimatedPrice is number);
    }

    function isValidPricing(data) {
      return data.keys().hasAll(['prices'])
        && data.prices is map
        && data.prices.keys().hasAll(['aodai-solo', 'kiyieu-lop', 'cophuc-heritage', 'photobook-print', 'extraPerPerson'])
        && data.prices['aodai-solo'] is number && data.prices['aodai-solo'] >= 50000 && data.prices['aodai-solo'] <= 10000000
        && data.prices['kiyieu-lop'] is number && data.prices['kiyieu-lop'] >= 50000 && data.prices['kiyieu-lop'] <= 10000000
        && data.prices['cophuc-heritage'] is number && data.prices['cophuc-heritage'] >= 50000 && data.prices['cophuc-heritage'] <= 10000000
        && data.prices['photobook-print'] is number && data.prices['photobook-print'] >= 50000 && data.prices['photobook-print'] <= 10000000
        && data.prices.extraPerPerson is number && data.prices.extraPerPerson >= 0 && data.prices.extraPerPerson <= 500000;
    }

    // Bang gia goi (settings/pricing): ai cung doc duoc, chi admin duoc ghi,
    // du lieu khong hop le (ngoai gioi han gia) thi deny.
    // (v6) TACH RIENG pricing / content: rule cu bat moi doc settings phai
    // co `prices` nen doc content se bi chan. Ca 2 doc deu: public read,
    // CHI ADMIN create/update/delete.
    match /settings/pricing {
      allow get, list: if true;
      allow create, update: if isAdmin() && isValidPricing(incoming());
      allow delete: if isAdmin();
    }

    function isValidContent(data) {
      return data.keys().hasAll(['content'])
        && data.content is map
        && (!('heroTitle' in data.content) || (data.content.heroTitle is string && data.content.heroTitle.size() <= 200))
        && (!('heroSubtitle' in data.content) || (data.content.heroSubtitle is string && data.content.heroSubtitle.size() <= 500))
        && (!('heroPrimaryCta' in data.content) || (data.content.heroPrimaryCta is string && data.content.heroPrimaryCta.size() <= 100))
        && (!('heroSecondaryCta' in data.content) || (data.content.heroSecondaryCta is string && data.content.heroSecondaryCta.size() <= 100))
        && (!('marqueeText' in data.content) || (data.content.marqueeText is string && data.content.marqueeText.size() <= 500))
        && (!('aboutName' in data.content) || (data.content.aboutName is string && data.content.aboutName.size() <= 100))
        && (!('aboutRole' in data.content) || (data.content.aboutRole is string && data.content.aboutRole.size() <= 200))
        && (!('aboutBioShort' in data.content) || (data.content.aboutBioShort is string && data.content.aboutBioShort.size() <= 500))
        && (!('aboutBioLong' in data.content) || (data.content.aboutBioLong is string && data.content.aboutBioLong.size() <= 500))
        && (!('contactAreas' in data.content) || (data.content.contactAreas is string && data.content.contactAreas.size() <= 500))
        && (!('contactHours' in data.content) || (data.content.contactHours is string && data.content.contactHours.size() <= 200))
        && (!('contactNote' in data.content) || (data.content.contactNote is string && data.content.contactNote.size() <= 500))
        && (!('footerTagline' in data.content) || (data.content.footerTagline is string && data.content.footerTagline.size() <= 200))
        && (!('packageDescriptions' in data.content) || data.content.packageDescriptions is map);
    }

    // Noi dung giao dien (settings/content, v6): public read, CHI ADMIN ghi.
    match /settings/content {
      allow get, list: if true;
      allow create, update: if isAdmin() && isValidContent(incoming());
      allow delete: if isAdmin();
    }

    function isValidProofingPhoto(data) {
      return data.keys().hasAll(['leadId', 'url', 'order', 'phoneSuffix'])
        && data.leadId is string && data.leadId.matches('^KY-[A-Z0-9]+$')
        && data.url is string && data.url.size() > 0 && data.url.size() <= 2000
        && data.order is number
        && data.phoneSuffix is string && data.phoneSuffix.size() == 4
        && (!('thumbUrl' in data) || (data.thumbUrl is string && data.thumbUrl.size() <= 2000));
    }

    // Anh proofing theo don (v6): public read, CHI ADMIN write.
    match /proofing_photos/{photoId} {
      allow get, list: if true;
      allow create, update: if isAdmin() && isValidId(photoId) && isValidProofingPhoto(incoming());
      allow delete: if isAdmin() && isValidId(photoId);
    }

    function isValidProofingSelection(data, leadId) {
      return data.keys().hasAll(['leadId', 'selectedIds', 'ratings', 'notes'])
        && data.leadId == leadId
        && data.selectedIds is list
        && data.ratings is map
        && data.notes is map;
    }

    // Lua chon cua khach (v6): public CHI DUOC get dung doc theo ma don
    // minh nhap (khong list toan bo) va create/update doc do — voi dieu
    // kien leadId trong du lieu phai == id doc (khong ghi de doc don khac).
    // Delete + list chi admin. Ma don + 4 so cuoi SDT la "mat khau".
    match /proofing_selections/{leadId} {
      allow get: if true;
      allow list: if isAdmin();
      allow create, update: if isValidId(leadId) && isValidProofingSelection(incoming(), leadId);
      allow delete: if isAdmin();
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Admins collection
    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }

    // Booking Leads: Anyone can submit a booking inquiry, Admin can manage
    match /booking_leads/{leadId} {
      allow create: if isValidId(leadId) && isValidBookingLead(incoming());
      allow get, list, update, delete: if isAdmin();
    }

    // Email Notification Logs
    match /email_logs/{logId} {
      allow create: if isValidId(logId) && incoming().keys().hasAll(['leadId', 'toEmail', 'subject', 'sentAt']);
      allow get, list, update, delete: if isAdmin();
    }

    function isValidPhoto(data) {
      return data.keys().hasAll(['title', 'category', 'location', 'camera', 'lens', 'image'])
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 200
        && data.category is string && data.category.size() <= 64
        && data.location is string && data.location.size() <= 200
        && data.camera is string && data.camera.size() <= 100
        && data.lens is string && data.lens.size() <= 100
        && data.image is string && data.image.size() <= 50000;
    }

    // Portfolio Photos: Public read for visitors, create with validation, Admin update/delete
    match /portfolio_photos/{photoId} {
      allow get, list: if true;
      allow create: if isAdmin() && isValidId(photoId) && isValidPhoto(incoming());
      allow update, delete: if isAdmin() && isValidId(photoId);
    }
  }
}
